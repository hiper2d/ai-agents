{
  "name": "@hiper2d/ai-agents",
  "version": "0.1.3",
  "description": "Multi-provider AI agent layer: schema-validated asks, thinking extraction, a model catalog with per-model tuning defaults, and token cost accounting for 11 LLM providers.",
  "license": "MIT",
  "author": "hiper2d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiper2d/ai-agents.git"
  },
  "homepage": "https://github.com/hiper2d/ai-agents#readme",
  "bugs": {
    "url": "https://github.com/hiper2d/ai-agents/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "mistral",
    "zod",
    "structured-output",
    "pricing"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --watchman=false",
    "test:live": "jest --config jest.live.config.js --watchman=false --runInBand",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.60.0",
    "@google/genai": "^2.15.0",
    "@mistralai/mistralai": "^1.10.0",
    "openai": "5.20.3",
    "zod-to-json-schema": "^3.24.6"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "zod": "^3.25.76"
  }
}
